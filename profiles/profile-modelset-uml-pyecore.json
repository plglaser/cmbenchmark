{
  "name": "ModelSet_UML_PyEcore_Benchmark_01",
  "version": "1.0",
  "output_path": "../out/modelset-uml-pyecore",
  "scan": {
    "dataset_path": "./data/modelset-uml",
    "include": ["*.xmi"],
    "exclude": ["**/tmp/**"],
    "size_limit_mb": 100
  },
  "parse": {
    "parser_language": "UML-XML-PyEcore"
  },
  "measure": {
    "parse": {
      "enabled": true
    },
    "lexical": {
      "enabled": true,
      "include_nodes": true,
      "include_edges": false,
      "label_attributes": ["name"],
      "enable_d2_m1": true,
      "enable_d2_m2": true,
      "enable_d2_m3": true,
      "enable_d2_m4": true,
      "enable_d2_m5": true,
      "tokenizer": {
        "name": "simple_en",
        "split_on_punct": true,
        "split_camel_case": true,
        "strip": true,
        "lowercase": false,
        "keep_numbers": true,
        "collapse_whitespace": true,
        "unicode_nfkc": true
      }
    },
    "constructs": {
      "enabled": true,
      "enable_d3_m1": true,
      "enable_d3_m2": true,
      "enable_d3_m3": true
    }
  },
  "report": {}
}
